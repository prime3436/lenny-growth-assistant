# ─────────────────────────────────────────────
# Lenny Growth Assistant — Environment Config
# Copy this file to .env and fill in your values
# ─────────────────────────────────────────────

# ── App ──────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
SECRET_KEY=change-me-in-production-use-a-long-random-string

# ── Database (PostgreSQL) ─────────────────────
DATABASE_URL=postgresql+asyncpg://lenny:lenny@localhost:5432/lenny_db

# ── LLM Provider ─────────────────────────────
# Options: "anthropic" | "openai" | "ollama"
LLM_PROVIDER=anthropic

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# Ollama (local)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Claude model (when using anthropic)
CLAUDE_MODEL=claude-3-5-sonnet-20241022

# ── RAG / Retrieval ───────────────────────────
TRANSCRIPTS_DIR=../data/transcripts
BM25_TOP_K=5
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# ── CORS ─────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:8080,http://127.0.0.1:5500
